<?xml version="1.0" encoding="utf-8"?>
<!--
  The dev backend is plain HTTP on the host machine, and targetSdk 34 means
  the platform blocks cleartext by default. Scoped to the loopback addresses
  rather than flipping android:usesCleartextTraffic="true" on the whole app:
  a blanket flag would also permit cleartext to any production host a future
  build points at, silently, which is exactly the mistake the platform
  default exists to prevent.

  Running against a physical device instead of the emulator? Add that
  machine's LAN address here alongside its BASE_URL/WS_URL in AppContainer.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The emulator's alias for the host machine's localhost. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
